generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String   @unique
  usernameKey  String   @unique
  passwordHash String
  bestScore    Int      @default(0)
  createdAt    DateTime @default(now())
}
